# Copy this file to .env and fill in REAL values. NEVER commit .env.
# Server
PORT=3000
HOST=0.0.0.0

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to sign session cookies. Must be a long, unguessable random string.
SESSION_SECRET=change_me_to_a_long_random_string

# Node environment: development | production
NODE_ENV=development

# Frontend origin (for CORS/cookies). In prod this is your deployed frontend URL.
FRONTEND_ORIGIN=http://localhost:5173

# Security: how far in the future (ms) a session is valid. 7 days default.
SESSION_TTL_MS=604800000

# Rate limiting: max requests per window.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
